[Unit]
Description=Caca A1 Always Free (loop ate conseguir capacidade)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/smart_auto
ExecStart=/home/ubuntu/venv/bin/python /home/ubuntu/smart_auto/provisionar_a1.py
# Sucesso e abort intencional saem com exit 0 (nao reiniciam); so crash (exit!=0)
# e recuperado. Evita ficar morto por erro transitorio da OCI.
Restart=on-failure
RestartSec=30
StandardOutput=append:/home/ubuntu/smart_auto/caca_a1.log
StandardError=append:/home/ubuntu/smart_auto/caca_a1.log

[Install]
WantedBy=multi-user.target
